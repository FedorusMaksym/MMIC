{
  "name": "project",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start:frontend": "parcel src/*.html",
    "start:backend": "json-server db.json --port 3001",
    "sass": "sass --watch src/scss/main.scss src/css/main.css",
    "build": "rm -rf package-lock.json node_modules && npm install && node node_modules/parcel/lib/cli.js build src/*.html --dist-dir docs --public-url ./ --no-optimize --no-cache",
    "start": "npx serve docs -l ${PORT:-10000}"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12.0",
    "json-server": "^1.0.0-beta.15",
    "parcel": "^2.12.0",
    "sass": "^1.77.8",
    "serve": "^14.2.1"
  }
}
